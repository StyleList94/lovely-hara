{
  "name": "lovely-hara",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "sh scripts/install-motion-plus.sh",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "lint": "oxlint && eslint",
    "lint:fix": "oxlint --fix && eslint --fix",
    "format": "oxfmt . && prettier --write '**/*.astro'",
    "format:check": "oxfmt --check . && prettier --check '**/*.astro'",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.0.1",
    "@astrojs/react": "6.0.0",
    "@stylelist94/nine-beauty-actress": "^2.2.0",
    "astro": "7.0.3",
    "bignumber.js": "^11.1.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jimp": "1.6.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "astro-eslint-parser": "^2.1.0",
    "eslint": "^10.6.0",
    "eslint-config-stylish": "^3.3.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
